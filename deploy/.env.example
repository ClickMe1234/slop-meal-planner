# Copy this file to deploy/.env. Do not commit deploy/.env.
# Generate secrets, for example: openssl rand -hex 32

# Use an immutable release tag in production. Never use latest.
APP_VERSION=0.9.0
APP_REVISION=local
# For a published image set the repository without a tag; APP_VERSION supplies the tag.
MEAL_PLANNER_IMAGE=meal-planner

# Unraid paths. For a developer workstation, use ./.runtime and ./backups;
# relative bind paths are resolved from the deploy directory.
APPDATA_ROOT=/mnt/user/appdata/meal-planner
BACKUP_ROOT=/mnt/user/backups/meal-planner
PUID=99
PGID=100

WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
TIMEZONE=Europe/London
ALLOWED_HOSTS=localhost,127.0.0.1,meal-planner,meal-planner.local
COOKIE_SECURE=false
LOG_LEVEL=INFO
# Get a free key from https://fdc.nal.usda.gov/api-key-signup.html.
# DEMO_KEY is for short-lived exploration only and is exhausted very quickly.
USDA_API_KEY=
REMOTE_FOOD_SEARCH_ENABLED=true
OPEN_FOOD_FACTS_ENABLED=true
OPEN_FOOD_FACTS_TIMEOUT_SECONDS=10

POSTGRES_DB=meal_planner
POSTGRES_USER=meal_planner
# Keep this URL-safe because it is embedded in the internal PostgreSQL URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value

# SECRET_KEY signs application state. SETUP_TOKEN is needed only for first-owner setup.
SECRET_KEY=replace-with-a-different-long-random-value
SETUP_TOKEN=replace-with-a-one-time-long-random-value

# Maintenance retention tiers. A nightly backup is classified as monthly on the first
# day, weekly on Sunday, and daily otherwise.
RETAIN_DAILY=14
RETAIN_WEEKLY=8
RETAIN_MONTHLY=12
